<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity is an AndroidX AppCompatActivity and uses this theme. -->
    <style name="Theme.TV49East" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111113</item>
        <item name="android:colorAccent">#CFBAFD</item>
        <item name="colorAccent">#CFBAFD</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111113</item>
        <item name="android:navigationBarColor">#0B0B0D</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Plain android.app.Activity components must never inherit AppCompat's
         theme contract. This is deliberately platform-only so launcher and
         FadCam handoff startup cannot fail in AppCompatDelegate. -->
    <style name="Theme.TV49East.Platform" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#09090C</item>
        <item name="android:colorAccent">#CFBAFD</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
