<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        MainActivity extends AndroidX AppCompatActivity, so this MUST be an
        AppCompat descendant. The previous platform Theme.Material parent
        caused the installed release APK to crash during Activity startup
        with AppCompat's theme-enforcement check.
    -->
    <style name="Theme.TV49East" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111113</item>
        <item name="android:colorAccent">#CFBAFD</item>
        <item name="colorAccent">#CFBAFD</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111113</item>
        <item name="android:navigationBarColor">#0B0B0D</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
