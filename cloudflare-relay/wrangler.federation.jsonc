{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tv49-east-federation",
  "main": "src/federation-actions.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "vars": {
    "FEDERATION_DOMAIN": "testagram.site",
    "ACTOR_BASE_URL": "https://federation.testagram.site",
    "FEDERATION_USER_AGENT": "TV49-East-Federation/1.0"
  },
  "secrets": { "required": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "SUPABASE_SERVICE_ROLE_KEY", "FEDERATION_KEY_ENCRYPTION_SECRET"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
