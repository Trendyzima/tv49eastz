{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tv49eastz-relay",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "vars": {
    "GATEWAY_ORIGIN": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_TUNNEL",
        "class_name": "RelayTunnel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayTunnel"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["StreamGatewayContainer"]
    },
    {
      "tag": "v3-cloud-run",
      "deleted_classes": ["StreamGatewayContainer"]
    }
  ]
}
