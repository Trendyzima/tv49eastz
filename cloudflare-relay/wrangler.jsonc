{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tv49eastz-relay",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://vfhehknmxxedvesdvpew.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_PwOotJZQHwS9xnCFwUjHsQ_uXLNqkk9"
  },
  "r2_buckets": [
    { "binding": "SOCIAL_MEDIA", "bucket_name": "tv49-east-social-media" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_TUNNEL", "class_name": "RelayTunnel" },
      { "name": "SESSION_STORE", "class_name": "SessionStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayTunnel"] },
    { "tag": "v2", "new_sqlite_classes": ["StreamGatewayContainer"] },
    { "tag": "v3-cloud-run", "deleted_classes": ["StreamGatewayContainer"] },
    { "tag": "v4-native-gateway", "new_sqlite_classes": ["SessionStore"] }
  ]
}
