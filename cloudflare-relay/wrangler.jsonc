{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tv49eastz-relay",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "StreamGatewayContainer",
      "image": "../stream-gateway/Dockerfile",
      "max_instances": 10,
      "instance_type": "basic",
      "constraints": {
        "regions": ["AFR"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_TUNNEL",
        "class_name": "RelayTunnel"
      },
      {
        "name": "STREAM_GATEWAY",
        "class_name": "StreamGatewayContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayTunnel"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["StreamGatewayContainer"]
    }
  ]
}
