# Public HTTPS Cloudflare relay. Keep this free of query parameters;
# the control plane appends the stream id and signed ticket at runtime.
PUBLIC_RELAY_URL=https://stream.example.com/v1/relay

# Optional default channel metadata for /api/catalog. This is no longer a
# relay-wide tenant restriction; each signed ticket may target its own stream.
PUBLIC_STREAM_ID=creator-001
PUBLIC_STREAM_NAME=FadCam Live
PUBLIC_STREAM_OWNER=FadCam Creator

# Private server-to-server/control-plane values.
PUBLIC_GATEWAY_URL=https://gateway.example.com
EDGE_SIGNING_SECRET=replace-with-a-long-random-secret
EDGE_PUBLISH_SECRET=replace-with-a-different-long-random-secret

# Must match Cloudflare RELAY_DEVICE_SECRET. Never ship this in the APK.
# A trusted provisioning service uses /api/device-ticket to mint short-lived
# producer tickets and hands those tickets to authenticated producer devices.
EDGE_DEVICE_SIGNING_SECRET=replace-with-a-separate-long-random-secret
