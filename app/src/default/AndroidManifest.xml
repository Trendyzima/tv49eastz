<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.tv49.com.permission.PUBLISH_FADCAM" />

    <!--
        Production/default-variant hardening.

        FadRecScreenshotAccessibilityService is a legacy screenshot shortcut
        implemented as an Android AccessibilityService. It is not required by
        the camera, recording, playback, or media-management paths.

        Google Play Protect treats sideloaded applications exposing sensitive
        Accessibility capabilities as high-risk. Remove the service from the
        packaged default APK while keeping the protected main source manifest
        and Java implementation intact.
    -->
    <application>
        <service
            android:name="com.fadcam.service.FadRecScreenshotAccessibilityService"
            tools:node="remove" />

        <activity
            android:name="com.fadcam.LiveProducerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="TV 49 East Producer" />

        <!-- Dedicated one-tap live interview control. The activity launcher
             starts the LAN HLS server and then dual-camera PiP from a
             user-visible foreground context. -->
        <service
            android:name="com.fadcam.services.LiveInterviewTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile_videocam_dual"
            android:label="TV 49 Producer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
