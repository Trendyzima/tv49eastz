<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Production release hardening.

        The main manifest contains legacy/sensitive capabilities used by some
        development variants. The production FadCam release does not need
        broad all-files access or battery-optimization exemption, so remove
        both from the merged release manifest.

        The main manifest also contains legacy alternate launcher aliases.
        They are not part of the production identity of FadCam and are removed
        from the release artifact to avoid misleading launcher identities.

        Google Play Protect can block internet-sideloaded applications that
        expose sensitive Accessibility capabilities. FadCam's legacy screenshot
        accessibility service is not required by the production camera/recording
        path, so keep that service out of the release artifact while leaving the
        protected main application source unchanged.

        Android 13+ camera apps should not request broad READ_MEDIA_VIDEO access
        merely to read media they created themselves. FadCam can access its own
        media through scoped MediaStore/app-owned storage, while user-selected
        external media should use a picker/URI grant. Remove the broad media
        permission from the production artifact.
    -->

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_MEDIA_VIDEO"
        tools:node="remove" />

    <!-- Preserve legacy storage access only where the platform still uses it. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:replace="android:maxSdkVersion" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:replace="android:maxSdkVersion" />

    <service
        android:name="com.fadcam.service.FadRecScreenshotAccessibilityService"
        tools:node="remove" />

    <!--
        Android 14+ requires a declared subtype for TYPE_SPECIAL_USE. Keep the
        existing specialUse service because the annotation overlay is a real
        user-facing FadRec feature, but describe its narrow purpose explicitly
        for the merged production manifest and Play Console review.
    -->
    <service
        android:name="com.fadcam.fadrec.ui.AnnotationService"
        tools:node="merge">
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="user-initiated on-device screen annotation overlay during FadRec screen recording" />
    </service>

    <activity-alias
        android:name=".MainActivity.AlternativeIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.FadedIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.PalestineIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.PakistanIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.FadSecLabIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.NooristicIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.BatIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.RedBinaryIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.NotesIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.CalculatorIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.ClockIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.WeatherIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.FootballIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.CarIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.JetIcon"
        tools:node="remove" />
    <activity-alias
        android:name=".MainActivity.MinimalIcon"
        tools:node="remove" />
    <activity-alias
