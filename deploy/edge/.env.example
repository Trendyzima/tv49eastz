# Public edge
PUBLIC_BASE_URL=https://tv49.example

# Cloudflare relay data plane
# The producer bridge uses these values only when explicitly enabled.
CLOUDFLARE_PRODUCER_ENABLED=false
CLOUDFLARE_RELAY_URL=https://tv49eastz-relay.nahashonnyaga794.workers.dev
CLOUDFLARE_STREAM_ID=fadcam-production-001
RELAY_DEVICE_SECRET=CHANGE_ME_RELAY_DEVICE_SECRET

# Device tunnel broker
TUNNEL_LISTEN=:9443
TUNNEL_PROXY_LISTEN=127.0.0.1:8785
DEVICE_REGISTRY_PATH=/secure/tv49eastz/devices.json
TUNNEL_CA=/secure/tv49eastz/ca.pem
TUNNEL_CERT=/secure/tv49eastz/gateway.pem
TUNNEL_KEY=/secure/tv49eastz/gateway-key.pem

# Stream catalog
CATALOG_LISTEN=127.0.0.1:8790
TUNNEL_PROXY_BASE_URL=http://127.0.0.1:8785
CREATOR_REGISTRY_FILE=/secure/tv49eastz/creators.json
CREATOR_PUBLISH_KEY=CHANGE_ME
RELAY_SIGNING_SECRET=CHANGE_ME_DIFFERENT
ORIGIN_RESOLVE_KEY=CHANGE_ME_ORIGIN

# Origin shield (optional independent cache tier)
SHIELD_LISTEN=127.0.0.1:8795
SHIELD_CATALOG_URL=https://127.0.0.1:8790
SHIELD_CATALOG_KEY=CHANGE_ME_ORIGIN
SHIELD_TUNNEL_URL=http://127.0.0.1:8785

# FadCam server room
TAP_LISTEN=127.0.0.1:8788
# Prefer automatic discovery in production. Set only for diagnostics:
# TAP_UPSTREAM=http://192.168.1.50:8080
TAP_DISCOVERY_PORT=8080
TUNNEL_LOCAL_ADDR=127.0.0.1:8788
TUNNEL_GATEWAY=PUBLIC_EDGE_HOST:9443
TUNNEL_DEVICE_ID=fadcam-production-001

# Android receiver build-time public catalog URL.
# This is a public URL; never put any server-side secret here.
TV_EAST_CATALOG_URL=https://tv49.example/v1/catalog
