# Device side: run this alongside the existing FadCam server.
# The agent makes outbound TLS connections; port 8080 is never exposed publicly.
TUNNEL_GATEWAY=gateway.example:9443
TUNNEL_SERVER_NAME=tunnel.example
TUNNEL_CA=/etc/tv49eastz/ca.pem
TUNNEL_CERT=/etc/tv49eastz/device.pem
TUNNEL_KEY=/etc/tv49eastz/device-key.pem
TUNNEL_POOL=8
# Bind to the local server-tap, not the FadCam public listener.
TUNNEL_LOCAL_ADDR=127.0.0.1:8786

# Gateway side:
# TUNNEL_LISTEN=:9443
# TUNNEL_FORWARD_LISTEN=127.0.0.1:8786
# TUNNEL_CA=/etc/tv49eastz/ca.pem
# TUNNEL_CERT=/etc/tv49eastz/gateway.pem
# TUNNEL_KEY=/etc/tv49eastz/gateway-key.pem
# TUNNEL_POOL=8
