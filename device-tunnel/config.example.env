# Gate 1 — LOCAL FadCam -> server-tap -> device-tunnel -> gateway.
# No VPS is required for the local FadCam endpoint. The gateway may run on
# the same LAN host or another host reachable by the device; the FadCam
# server itself remains on its existing local IP/port and is never published.

# Device side: run the tunnel agent in the same network namespace as the
# server-tap/FadCam endpoint.
TUNNEL_GATEWAY=gateway.example:9443
TUNNEL_SERVER_NAME=tunnel.example
TUNNEL_CA=/etc/tv49eastz/ca.pem
TUNNEL_CERT=/etc/tv49eastz/device.pem
TUNNEL_KEY=/etc/tv49eastz/device-key.pem
TUNNEL_DEVICE_ID=<enrolled-device-id>
TUNNEL_POOL=8

# server-tap currently defaults to 127.0.0.1:8788.
# Keep the existing FadCam HTTP server private; TAP_UPSTREAM is its local
# LAN/loopback URL, e.g. http://<fadcam-local-ip>:8080.
TUNNEL_LOCAL_ADDR=127.0.0.1:8788
TAP_LISTEN=127.0.0.1:8788
TAP_UPSTREAM=http://<fadcam-local-ip>:8080

# Publisher-control boundary. These credentials stay with the tunnel agent;
# they must NEVER be embedded in the FadCam APK.
# GATEWAY_CONTROL_URL is the HTTPS stream-gateway API origin (not the raw
# tunnel TCP listener). PUBLISHER_PUBLIC_KEY_FILE contains the X.509/PKIX
# public key generated by FadCam's Android Keystore during enrollment.
GATEWAY_CONTROL_URL=https://gateway.example:8787
GATEWAY_API_KEY=<server-side-secret>
PUBLISHER_PUBLIC_KEY_FILE=/etc/tv49eastz/fadcam-publisher-public.der
PUBLISHER_CONTROL_LISTEN=127.0.0.1:8789

# First pairing only: set a high-entropy one-time value here before starting
# the agent, then call FadCamTvPublisher.provision(deviceId, token). The
# agent writes the exact Android public key atomically and clears the token
# from its running process after successful enrollment. Do not ship this
# token in the APK or source tree.
PUBLISHER_ENROLL_TOKEN=<one-time-high-entropy-secret>

# The publisher-control listener is deliberately loopback-only. The Android
# FadCam client and this agent therefore must be co-located on the same device
# or in the same protected local network namespace. A separately hosted agent
# cannot be reached through 127.0.0.1 from the phone.

# Gateway side:
# TUNNEL_LISTEN=:9443
# TUNNEL_PROXY_LISTEN=127.0.0.1:8785
# TUNNEL_CA=/etc/tv49eastz/ca.pem
# TUNNEL_CERT=/etc/tv49eastz/gateway.pem
# TUNNEL_KEY=/etc/tv49eastz/gateway-key.pem
# TUNNEL_POOL=8

# stream-gateway must consume the device-tunnel gateway's loopback HTTP
# proxy, NOT the FadCam LAN address and NOT server-tap directly.
TUNNEL_PROXY_BASE_URL=http://127.0.0.1:8785
